APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# --- Laravel Sail (desarrollo local) ---
APP_PORT=8080
WWWUSER=1000
WWWGROUP=1000
# FORWARD_DB_PORT=5432
# SAIL_XDEBUG_MODE=off

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos ---
# Local: Sail publica el servicio `pgsql` con estas credenciales.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=planillas
DB_USERNAME=user_planillas
DB_PASSWORD=password

# Producción (Render): DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD y
# DB_CONNECTION=pgsql los inyecta render.yaml desde la base de datos gestionada.
# Además en Render se usan:
#   LOG_CHANNEL=stderr
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://<nombre-del-servicio>.onrender.com
#   SESSION_SECURE_COOKIE=true
#   APP_KEY=<php artisan key:generate --show>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true   # obligatorio en Render (HTTPS)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Token para la app móvil de asistencia QR (en Render: env var QR_API_TOKEN)
QR_API_TOKEN=

# --- Arranque del contenedor (docker/entrypoint.sh, usado en Render) ---
# OPTIMIZE_ON_BOOT=true   # config:cache + route:cache
# MIGRATE_ON_BOOT=true    # php artisan migrate --force
# SEED_ON_BOOT=false      # true SOLO en el primer deploy (los seeders no son idempotentes)
